# CrimeLens Environment Configuration

# Groq API key (get one at https://console.groq.com) — server-side AI extraction
GROQ_API_KEY=your_groq_api_key_here

# Neo4j graph database — required for all /api/graph/* routes.
# Local: bolt://localhost:7687 — Production: neo4j+s://<instance>.databases.neo4j.io (Aura)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password
NEO4J_DATABASE=neo4j
